
export CLAUDE_TOKEN_NAME="pb"
export CLAUDE_CODE_OAUTH_TOKEN="$(pass show claude/token-pb)"
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# CARGO_TARGET_DIR and jobs now live in ~/.cargo/config.toml instead, because an
# export here reaches only THIS shell — not a subprocess in a git worktree, which
# is how 8 agent builds filled the root disk on 2026-08-16.
