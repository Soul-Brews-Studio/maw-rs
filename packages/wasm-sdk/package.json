{
  "name": "@maw-rs/wasm-sdk",
  "version": "1.0.0",
  "description": "AssemblyScript SDK and host ABI bindings for maw WASM plugins",
  "type": "module",
  "exports": {
    ".": "./assembly/index.ts"
  },
  "scripts": {
    "build": "mkdir -p build && asc index.ts --outFile build/sdk-smoke.wasm --path node_modules --runtime stub --exportRuntime --noAssert",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@extism/as-pdk": "1.0.0",
    "assemblyscript": "0.27.31"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soul-Brews-Studio/maw-rs.git",
    "directory": "packages/wasm-sdk"
  },
  "homepage": "https://github.com/Soul-Brews-Studio/maw-rs/tree/main/packages/wasm-sdk",
  "bugs": {
    "url": "https://github.com/Soul-Brews-Studio/maw-rs/issues"
  },
  "files": [
    "assembly/",
    "index.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
