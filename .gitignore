target/
# isolated per-agent CARGO_TARGET_DIRs (one gate per target dir)
.tgt*/
# scripts/gate.sh isolated target dir + its lock (see docs/guides/gating.md)
target-gate*/
node_modules/
packages/*/node_modules/
examples/**/dist/
ψ/*
!ψ/teams/
ψ/
# ψ is a symlink to the maw-rs-oracle vault repo, not a directory in this
# repo — a trailing-slash pattern only matches real directories, so the
# symlink itself needs its own bare (no-slash) pattern to stay ignored.
ψ

# codex coder runtime homes (worktree-local CODEX_HOME)
.codex/
.maw-engine/

# maw writes its audit log and runtime state into a .maw/ directory in whatever
# tree it is run from (dispatcher.rs:567), so running the suite from the repo
# dirties crates/maw-cli/.maw/. Team charters live in .maw/teams/ and ARE meant
# to be kept -- same ignore-contents-but-keep-teams split as ψ/* + !ψ/teams/
# above. The `**/` is load-bearing: a pattern containing a slash is anchored to
# this file's directory, so a bare `.maw/*` would only match at the repo root
# and miss crates/maw-cli/.maw/ entirely. And the contents must be excluded
# rather than the directory itself -- git cannot re-include a path whose parent
# directory is excluded, so `.maw/` plus `!.maw/teams/` silently drops the
# charters. (#836)
**/.maw/*
!**/.maw/teams/

# nova builder worktrees
agents/
.envrc
